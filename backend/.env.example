# Supabase Database Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# Database credentials from Supabase dashboard
DB_USER=postgres
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD_HERE

# JWT Configuration
# Generate a random secret string (min 32 characters)
APP_JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
APP_JWT_EXPIRATION=86400000
